{
  "name": "ralt-ondc-monorepo",
  "version": "1.6.0",
  "private": true,
  "description": "RALT ONDC Logistics Service Provider (BPP) & Delivery Partner Fleet Monorepo",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm --filter '@ralt-ondc/*' build || npm --prefix services/ondc-lsp-service run build",
    "test": "npm --prefix services/ondc-lsp-service test && npm --prefix apps/delivery-app test",
    "test:coverage": "npm --prefix services/ondc-lsp-service run test:coverage && npm --prefix apps/delivery-app run test:coverage",
    "lint": "npm --prefix services/ondc-lsp-service run lint && npm --prefix apps/delivery-app run lint",
    "scan": "bash scripts/security-scan.sh",
    "check:all": "npm run lint && npm run scan && npm run test:coverage",
    "mobile:web": "npm --prefix apps/delivery-app run web",
    "mobile:android": "npm --prefix apps/delivery-app run android",
    "mobile:ios": "npm --prefix apps/delivery-app run ios",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "release": "semantic-release",
    "release:dry": "node scripts/release-preview.js",
    "version:sync": "node scripts/sync-versions.js",
    "push": "git push origin main",
    "push:codecommit": "git push codecommit main",
    "clean": "rm -rf node_modules apps/*/node_modules services/*/node_modules services/*/dist"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.10.0",
    "@types/supertest": "^6.0.3",
    "@types/ws": "^8.5.13",
    "conventional-changelog-conventionalcommits": "^8.0.0",
    "jest": "^29.7.0",
    "semantic-release": "^25.0.9",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
