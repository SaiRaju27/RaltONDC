# ==============================================================================
# RALT ONDC Logistics Provider (BPP) — Environment Configuration (.env)
# ==============================================================================

# Server & Environment
PORT=5001
NODE_ENV=development
LOG_LEVEL=debug

# Security & Tokens
JWT_SECRET=ralt_ondc_jwt_production_secret_key_2026
JWT_EXPIRY=30d
CORS_ORIGIN=*
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=240
OTP_RATE_LIMIT_MAX=10

# PostgreSQL 16 + PostGIS Spatial Datastore
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ralt_ondc_db
POSTGRES_POOL_MAX=20

# Redis Geospatial Cache & Pub/Sub
REDIS_URL=redis://redis:6379

# RabbitMQ Message Broker
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672
RABBITMQ_ENABLED=true
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# ONDC Network Identity (P2P - ONDC:LOG10)
ONDC_ENVIRONMENT=preprod
ONDC_SUBSCRIBER_ID=ralt.in
ONDC_SUBSCRIBER_URL=https://ralt.in/ondc
ONDC_DOMAIN=ONDC:LOG10
ONDC_ROLE=BPP
ONDC_UKID=2cb2bdeb-457b-47a9-bef9-c4d8954cbe49

# ONDC Cryptographic Keys (Ed25519)
ONDC_SIGNING_PUBLIC_KEY=YOUR_SIGNING_PUBLIC_KEY
ONDC_SIGNING_PRIVATE_KEY=YOUR_SIGNING_PRIVATE_KEY
ONDC_ENCRYPTION_PUBLIC_KEY=YOUR_ENCRYPTION_PUBLIC_KEY
ONDC_ENCRYPTION_PRIVATE_KEY=YOUR_ENCRYPTION_PRIVATE_KEY

# Commercial / Logistics Configuration
DEFAULT_DELIVERY_FEE=50
CURRENCY=INR
MAX_SERVICE_RADIUS_KM=10.0
ESTIMATED_DELIVERY_TIME_MINS=25

# Notifications (Delivery Partner App)
AIRBRICK_API_BASE=https://abapi.airbrick.com

# AWS Lightsail CI/CD Secrets (For GitHub Actions deployment)
LIGHTSAIL_HOST=
LIGHTSAIL_USER=ubuntu
LIGHTSAIL_SSH_KEY=
REGISTRY=ghcr.io/saipraneeth9
IMAGE_TAG=latest
