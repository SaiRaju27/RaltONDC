        },
        {
          "name": "5. Register Delivery Partner",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"9876543211\",\n  \"name\": \"Kiran Kumar\",\n  \"city\": \"Hyderabad\",\n  \"vehicle_number\": \"TS 08 AB 5678\",\n  \"vehicle_type\": \"motorcycle\"\n}"
