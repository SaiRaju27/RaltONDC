    {
      "name": "06. ONDC BPP Protocol Suite",
      "item": [
        {
          "name": "1. ONDC Search (Discovery)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"context\": {\n    \"domain\": \"ONDC:LOG10\",\n    \"country\": \"IND\",\n    \"city\": \"std:040\",\n    \"action\": \"search\",\n    \"core_version\": \"1.2.0\",\n    \"bap_id\": \"buyer-app.ondc.org\",\n    \"bap_uri\": \"https://buyer-app.ondc.org/protocol/v1\",\n    \"transaction_id\": \"tx-search-001\",\n    \"message_id\": \"msg-search-001\",\n    \"timestamp\": \"2026-11-02T12:00:00.000Z\",\n    \"ttl\": \"PT30S\"\n  },\n  \"message\": {\n    \"intent\": {\n      \"category\": { \"id\": \"Immediate Delivery\" },\n      \"fulfillment\": {\n        \"type\": \"Delivery\",\n        \"start\": { \"location\": { \"gps\": \"17.4399,78.3680\" } },\n        \"end\": { \"location\": { \"gps\": \"17.4589,78.3721\" } }\n      }\n    }\n  }\n}"
            },
            "url": "https://ralt.in/ondc/search"
          }
        },
        {
          "name": "2. ONDC Init (Order Draft)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"context\": {\n    \"domain\": \"ONDC:LOG10\",\n    \"country\": \"IND\",\n    \"city\": \"std:040\",\n    \"action\": \"init\",\n    \"core_version\": \"1.2.0\",\n    \"bap_id\": \"buyer-app.ondc.org\",\n    \"bap_uri\": \"https://buyer-app.ondc.org/protocol/v1\",\n    \"transaction_id\": \"tx-init-001\",\n    \"message_id\": \"msg-init-001\",\n    \"timestamp\": \"2026-11-02T12:00:00.000Z\",\n    \"ttl\": \"PT30S\"\n  },\n  \"message\": {\n    \"order\": {\n      \"provider\": { \"id\": \"ralt.in\" },\n      \"items\": [{ \"id\": \"Standard Delivery\", \"category_id\": \"Immediate Delivery\" }],\n      \"billing\": { \"name\": \"Arun Kumar\", \"phone\": \"+91 98765 43210\" },\n      \"fulfillments\": [{\n        \"type\": \"Delivery\",\n        \"start\": { \"location\": { \"gps\": \"17.4399,78.3680\", \"address\": { \"name\": \"Bawarchi Biryani House\", \"street\": \"Gachibowli\", \"city\": \"Hyderabad\", \"area_code\": \"500032\" } } },\n        \"end\": { \"location\": { \"gps\": \"17.4589,78.3721\", \"address\": { \"name\": \"Arun Kumar\", \"street\": \"Flat 402, Kondapur\", \"city\": \"Hyderabad\", \"area_code\": \"500084\" } } }\n      }]\n    }\n  }\n}"
            },
            "url": "https://ralt.in/ondc/init"
          }
        },
