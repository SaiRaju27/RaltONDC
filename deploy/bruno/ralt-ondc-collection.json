{
  "info": {
    "_postman_id": "ralt-ondc-logistics-complete-suite",
    "name": "RaltONDC Logistics API",
    "description": "Exhaustive production testing suite for Ralt ONDC Logistics Provider (BPP). All URLs are pre-filled with live HTTPS https://ralt.in endpoints with zero setup required.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01. System & Health",
      "item": [
        {
          "name": "Health Check (BPP Liveness)",
          "request": {
            "method": "GET",
            "url": "https://ralt.in/health"
          }
        },
        {
          "name": "Readiness Probe (Postgres + Redis + RabbitMQ)",
          "request": {
            "method": "GET",
            "url": "https://ralt.in/ready"
          }
        },
        {
          "name": "Prometheus Metrics Scrape",
          "request": {
            "method": "GET",
            "url": "https://ralt.in/metrics"
          }
        },
        {
          "name": "Root Service Health Status",
          "request": {
            "method": "GET",
            "url": "https://ralt.in/"
          }
        }
      ]
    },
    {
      "name": "02. Auth & Onboarding",
      "item": [
        {
          "name": "1. Send OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"9876543210\"\n}"
            },
            "url": "https://ralt.in/api/auth/send-otp"
          }
        },
        {
          "name": "2. Verify OTP & Issue JWT",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"9876543210\",\n  \"code\": \"1234\"\n}"
            },
            "url": "https://ralt.in/api/auth/verify-otp"
          }
        },
        {
          "name": "3. Direct Login Check",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"9876543210\"\n}"
