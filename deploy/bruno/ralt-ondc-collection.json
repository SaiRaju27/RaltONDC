          "name": "3. ONDC Confirm (Order Placement)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"context\": {\n    \"domain\": \"ONDC:LOG10\",\n    \"country\": \"IND\",\n    \"city\": \"std:040\",\n    \"action\": \"confirm\",\n    \"core_version\": \"1.2.0\",\n    \"bap_id\": \"buyer-app.ondc.org\",\n    \"bap_uri\": \"https://buyer-app.ondc.org/protocol/v1\",\n    \"transaction_id\": \"tx-confirm-001\",\n    \"message_id\": \"msg-confirm-001\",\n    \"timestamp\": \"2026-11-02T12:00:00.000Z\",\n    \"ttl\": \"PT30S\"\n  },\n  \"message\": {\n    \"order\": {\n      \"id\": \"order-ondc-1001\",\n      \"state\": \"Created\",\n      \"provider\": { \"id\": \"ralt.in\" },\n      \"billing\": { \"name\": \"Arun Kumar\", \"phone\": \"+91 98765 43210\" },\n      \"@ondc/org/linked_order\": {\n        \"provider\": {\n          \"descriptor\": { \"name\": \"Bawarchi Biryani House\" },\n          \"address\": { \"street\": \"Gachibowli\", \"city\": \"Hyderabad\", \"area_code\": \"500032\" }\n        }\n      },\n      \"fulfillments\": [{\n        \"id\": \"ful-1\",\n        \"type\": \"Delivery\",\n        \"start\": { \"location\": { \"gps\": \"17.4399,78.3680\", \"descriptor\": { \"name\": \"Bawarchi Biryani House\" } } },\n        \"end\": { \"location\": { \"gps\": \"17.4589,78.3721\", \"descriptor\": { \"name\": \"Arun Kumar\" } } }\n      }]\n    }\n  }\n}"
            },
            "url": "https://ralt.in/ondc/confirm"
          }
