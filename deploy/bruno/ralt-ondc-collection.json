          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"riderId\": \"RALT-RIDER-001\"\n}"
            },
            "url": "https://ralt.in/api/notifications/read-all"
          }
        }
      ]
