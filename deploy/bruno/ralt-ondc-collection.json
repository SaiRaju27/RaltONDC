            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"riderId\": \"RALT-RIDER-001\",\n  \"title\": \"New High Priority Order\",\n  \"message\": \"Pickup ready at Bawarchi Biryani House\",\n  \"channel\": \"PUSH\",\n  \"type\": \"ORDER\"\n}"
            },
